(rules
  (snap_angle 45)
  (autoroute_settings
    (mode MODE_WALKAROUND))

  (rule "JLCPCB Standard 4-Layer Design Rules"
    (condition "A.Type == '*'")
    (constraint clearance (min 0.127)))

  (rule "Trace to Trace (JLCPCB minimum)"
    (constraint clearance (min 0.127)))

  (rule "Trace to Pad"
    (constraint clearance (min 0.127)))

  (rule "Via Diameter (min 0.3mm)"
    (constraint via_diameter (min 0.3) (max 2.0)))

  (rule "Via Hole Size (min 0.1mm)"
    (constraint hole (min 0.1)))

  (rule "Pad to Via Clearance"
    (constraint clearance (min 0.15)))

  (rule "Annulus Ring (via via, min 0.05mm)"
    (constraint annular_width (min 0.05)))

  (rule "Silk to Trace (JLCPCB minimum)"
    (constraint silk_clearance (min 0.1)))

  (rule "Silk Width (min 0.1mm)"
    (constraint silk_width (min 0.1)))

  (rule "Edge Clearance (copper to board edge, min 0.5mm JLCPCB V-cut)"
    (constraint edge_clearance (min 0.5)))

  (rule "Min Trace Width (outer layers 0.1mm, inner 0.1mm)"
    (constraint track_width (min 0.1)))

  (rule "Min Pad Size (0.15mm)"
    (constraint pad_to_mask_clearance (min 0)))

  (rule "Solder Mask Clearance (JLCPCB default 0.1mm)"
    (constraint mask_clearance (min 0.1)))

  (rule "Power Planes - 5V Distribution"
    (condition "A.NetName == '+5V'")
    (constraint clearance (min 0.15))
    (constraint track_width (min 0.3)))

  (rule "Power Planes - 3V3 Distribution"
    (condition "A.NetName == '+3V3'")
    (constraint clearance (min 0.15))
    (constraint track_width (min 0.25)))

  (rule "GND Return Paths"
    (condition "A.NetName == 'GND'")
    (constraint clearance (min 0.127))
    (constraint track_width (min 0.25)))

  (rule "High-Speed Signals (I2S)"
    (condition "A.NetName == 'I2S_*'")
    (constraint clearance (min 0.15))
    (constraint track_width (min 0.15)))

  (rule "LED Data Line (single-ended)"
    (condition "A.NetName == 'LED_DATA'")
    (constraint track_width (min 0.2))
    (constraint clearance (min 0.127)))

  (rule "USB Differential Pair (D+/D-, 90 Ohm)"
    (constraint clearance (min 0.15))
    (constraint track_width (min 0.15)))

  (rule "Fiducial Alignment (minimum 3 per board)"
    (constraint fiducial_size (min 1.0) (max 2.0)))

  (rule "Test Points - DFM"
    (constraint hole (min 0.5)))

  (rule "Pad Spacing (min 0.2mm for 0402, 0.3mm for 0603)"
    (constraint min_pad_spacing (min 0.2)))

  (rule "No Vias Under Large ICs (except thermal vias)"
    (constraint clearance (min 0.2)))

  (rule "Thermal Relief on Power Pads"
    (constraint thermal_relief_gap (min 0.2)))

  (rule "Thickness Board = 1.6mm (FR-4 with ENIG)"
    (constraint board_thickness (min 1.5) (max 1.7)))

  (rule "Layer Stack (4-layer, JLC02160H-1LG)"
    (constraint layer_count 4))
)
