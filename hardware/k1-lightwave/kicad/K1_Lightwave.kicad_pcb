(kicad_pcb (version 20240108)
  (host "kicad" "8.0.0")
  (general
    (thickness 1.6)
    (edge_plating yes))
  (paper "A4")
  (title_block
    (title "K1 Lightwave - Dual ESP32-S3 Audio-Reactive LED Controller")
    (date "2025-10-23")
    (rev "A")
    (company "Lightwave Research")
    (comment 1 "PCB Design: KiCad")
    (comment 2 "Manufacturing: JLCPCB Standard 4-Layer (JLC02160H-1LG)")
    (comment 3 "Target Phase: Layout Development"))

  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user)
    (33 "F.Adhes" user)
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user)
    (37 "F.SilkS" user)
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user)
    (41 "Cmts.User" user)
    (42 "Eco1.User" user)
    (43 "Eco2.User" user)
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user)
    (47 "F.CrtYd" user)
    (48 "B.Fab" user)
    (49 "F.Fab" user))

  (setup
    (stackup
      (layer "F.SilkS" (type "Top Silk Screen"))
      (layer "F.Paste" (type "Top Solder Paste"))
      (layer "F.Mask" (type "Top Solder Mask") (color "Green") (thickness 0.01))
      (layer "F.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 1" (type "core") (thickness 0.3))
      (layer "GND.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 2" (type "prepreg") (thickness 0.6))
      (layer "PWR.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 3" (type "core") (thickness 0.3))
      (layer "B.Cu" (type "copper") (thickness 0.035))
      (layer "B.Mask" (type "Bottom Solder Mask") (color "Green") (thickness 0.01))
      (layer "B.Paste" (type "Bottom Solder Paste"))
      (layer "B.SilkS" (type "Bottom Silk Screen")))
    (copper_finish "ENIG")
    (dielectric_constant 4.6)
    (loss_tangent 0.02))

  (net 0 "")
  (net 1 "+5V")
  (net 2 "+3V3")
  (net 3 "GND")
  (net 4 "I2S_SD")
  (net 5 "I2S_WS")
  (net 6 "I2S_SCK")
  (net 7 "LED_DATA")
  (net 8 "USB_D+")
  (net 9 "USB_D-")

  (gr_line (start 10 10) (end 100 10) (layer "Edge.Cuts") (width 0.1) (tstamp "11111111-1111-1111-1111-111111111111"))
  (gr_line (start 100 10) (end 100 80) (layer "Edge.Cuts") (width 0.1) (tstamp "22222222-2222-2222-2222-222222222222"))
  (gr_line (start 100 80) (end 10 80) (layer "Edge.Cuts") (width 0.1) (tstamp "33333333-3333-3333-3333-333333333333"))
  (gr_line (start 10 80) (end 10 10) (layer "Edge.Cuts") (width 0.1) (tstamp "44444444-4444-4444-4444-444444444444"))

  (gr_text "K1 Lightwave Skeleton\nReady for Layout Development\nTarget: 100x80mm Form Factor"
    (at 55 45 0)
    (layer "B.SilkS")
    (effects
      (font (size 2 2) (thickness 0.3))
      (justify center)))

  (footprint "" (at 50 40 0) (uuid "55555555-5555-5555-5555-555555555555"))
)
