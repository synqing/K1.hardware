(kicad_pcb (version 20231009) (generator "K1-Gen")
  (general (thickness 1.6))
  (paper "A4")
  (layers
    (0 "F.Cu" signal) (31 "B.Cu" signal)
    (36 "B.SilkS" user) (37 "F.SilkS" user)
    (38 "B.Mask" user) (39 "F.Mask" user)
    (44 "Edge.Cuts" user)
  )
  (setup (stackup (layer "F.Cu") (layer "B.Cu")))
  (gr_rect (start 10 10) (end 110 70) (layer "Edge.Cuts") (width 0.1))

  (net_class "Default" "Default rules"
    (clearance 0.20) (trace_width 0.25)
    (via_dia 0.80) (via_drill 0.40)
    (uvia_dia 0.30) (uvia_drill 0.10)
  )
  (net_class "LED_POWER" "High-current LED 5V"
    (clearance 0.50) (trace_width 2.00)
    (via_dia 1.60) (via_drill 0.80)
    (add_net "LED_5V")
  )
  (net_class "VBUS" "USB 5V controller domain"
    (clearance 0.25) (trace_width 0.80)
    (via_dia 1.20) (via_drill 0.60)
    (add_net "VBUS_USB_5V")
  )
  (net_class "LED_DATA" "WS2812/SK6812 data"
    (clearance 0.20) (trace_width 0.30)
    (via_dia 0.80) (via_drill 0.40)
    (add_net "LED_DATA1_IN") (add_net "LED_DATA2_IN")
    (add_net "LED_DATA3_IN") (add_net "LED_DATA4_IN")
  )
  (net_class "I2C" "I2C buses"
    (clearance 0.20) (trace_width 0.30)
    (via_dia 0.80) (via_drill 0.40)
    (add_net "SDA") (add_net "SCL")
  )
  (net_class "USB" "USB D+/D-"
    (clearance 0.20) (trace_width 0.25)
    (diff_pair_width 0.15) (diff_pair_gap 0.15)
    (via_dia 0.80) (via_drill 0.40)
    (add_net "USB_D+") (add_net "USB_D-")
  )
)
