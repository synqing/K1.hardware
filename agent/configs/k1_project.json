{
  "project": {
    "name": "K1 Lightwave",
    "description": "ESP32-S3 addressable LED controller with SPI/USB",
    "version": "revA"
  },
  "board_file": "hardware/k1-lightwave/kicad/K1_Lightwave.kicad_pcb",
  "output_dir": "fabpack_out",
  "freerouting_jar": "tools/freerouting.jar",
  "freerouting_timeout": 1800,
  "stackup": {
    "layers": 2,
    "thickness_mm": 1.6,
    "copper_oz": 1.0,
    "finish": "HASL",
    "dielectric": {
      "layers": [
        {
          "name": "F.Cu",
          "type": "copper",
          "thickness_mm": 0.035
        },
        {
          "name": "core/prepreg",
          "type": "dielectric",
          "thickness_mm": 1.53
        },
        {
          "name": "B.Cu",
          "type": "copper",
          "thickness_mm": 0.035
        }
      ]
    }
  },
  "dfm_profile": "jlc_standard",
  "dfm_rules": {
    "jlc": {
      "trace_width_min_mm": 0.15,
      "trace_space_min_mm": 0.15,
      "via_drill_min_mm": 0.3,
      "via_annular_min_mm": 0.15,
      "copper_to_edge_min_mm": 0.4,
      "mask_clearance_mm": 0.2,
      "silk_text_width_min_mm": 0.254
    }
  },
  "netclasses": [
    {
      "name": "Default",
      "description": "Default trace width and clearance",
      "trace_width_mm": 0.25,
      "clearance_mm": 0.20,
      "via_drill_mm": 0.3
    },
    {
      "name": "SPI_High_Speed",
      "description": "SPI bus (20-40 MHz)",
      "trace_width_mm": 0.25,
      "clearance_mm": 0.25,
      "via_drill_mm": 0.3,
      "length_match_mm": 5.0
    },
    {
      "name": "USB_FS",
      "description": "USB Full-Speed differential pair (90 Ω)",
      "trace_width_mm": 0.2,
      "clearance_mm": 0.15,
      "via_drill_mm": 0.3,
      "differential_impedance_ohm": 90
    },
    {
      "name": "Power",
      "description": "Power distribution",
      "trace_width_mm": 0.5,
      "clearance_mm": 0.25,
      "via_drill_mm": 0.35
    }
  ],
  "constraints": {
    "spi": {
      "enabled": true,
      "frequency_mhz": 40,
      "length_match_tolerance_mm": 5.0,
      "series_resistor_ohm": [22, 47],
      "notes": "SCK is reference; DQ traces matched to SCK ±5mm"
    },
    "usb": {
      "enabled": false,
      "usb_version": "1.1",
      "impedance_diff_ohm": 90,
      "impedance_tolerance_percent": 10,
      "esd_distance_max_mm": 10,
      "series_resistor_ohm": [22, 33],
      "notes": "Optional future feature"
    }
  },
  "thermal": {
    "ambient_temp_c": 25,
    "max_junction_temp_c": 85,
    "target_theta_ja_k_w": 80,
    "decap_distance_max_mm": 3.0,
    "via_array_min_count": 9,
    "via_spacing_mm": 1.0,
    "notes": "Thermal vias under ESP32-S3 and regulators"
  },
  "fiducials": {
    "required_count": 3,
    "diameter_mm": 2.0,
    "pad_diameter_mm": 3.0,
    "placement": "corners_plus_one"
  },
  "testpoints": {
    "required": false,
    "types": ["power_rails", "critical_signals"]
  },
  "silkscreen": {
    "text_height_mm": 1.0,
    "text_width_min_mm": 0.254,
    "courtyard_clearance_mm": 0.25
  },
  "soldermask": {
    "clearance_mm": 0.2,
    "tent_vias": true,
    "allow_bridges": false
  },
  "manufacturers": [
    {
      "name": "JLC PCB (JLCPCB)",
      "profile": "jlc_standard",
      "capabilities": {
        "min_trace_space_mm": 0.15,
        "min_via_drill_mm": 0.3,
        "aspect_ratio_max": 10
      },
      "quotes_url": "https://jlcpcb.com"
    }
  ],
  "metadata": {
    "created_by": "K1 Expert PCB Design Agent",
    "created_date": "2025-10-24",
    "last_updated": "2025-10-24",
    "kicad_version": "9.0",
    "notes": "Configuration auto-generated from K1_Lightwave.kicad_pcb and design specifications"
  }
}
